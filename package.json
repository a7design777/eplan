{
  "name": "eplan",
  "version": "1.0.0",
  "description": "Планувальник маршрутів для електромобілів по Європі",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply eplan --remote",
    "db:migrate:local": "wrangler d1 migrations apply eplan --local",
    "stations:fetch": "node scripts/fetch-stations.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "maplibre-gl": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true,
    "fsevents@2.3.3": true
  },
  "private": true
}
