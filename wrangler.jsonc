{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eplan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  "routes": [{ "pattern": "e.car-ua.com", "custom_domain": true }],

  // Лишаємо *.workers.dev увімкненим: зручно перевіряти деплой, не чіпаючи бойовий домен.
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eplan",
      "database_id": "bfd7d49c-3950-4d08-9113-59b6197ceea5",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "9089a3ccff0b46d985d34dc4c7be00b3"
    }
  ],

  "triggers": {
    // щотижневе оновлення дзеркала станцій з OpenChargeMap
    "crons": ["0 3 * * 1"]
  },

  "vars": {
    "VALHALLA_URL": "https://valhalla1.openstreetmap.de",
    "VALHALLA_CLIENT_ID": "e.car-ua.com"
  }
}
